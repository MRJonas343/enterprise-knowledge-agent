# Browser-visible token for the Next.js frontend.
#
# Next.js loads .env* files from this directory, never from the repository root,
# so this value does not belong in the root .env next to the gateway's settings.
# That is the entire reason this file exists.
#
# The value must equal the token half of one entry in the gateway's API_TOKENS.
# With API_TOKENS=alice:tok_abc the browser sends tok_abc.
#
# It is inlined into the client bundle at build time, so it authenticates the
# gateway against anonymous callers but is NOT a secret from anyone who loads
# the page. Restart `next dev` after changing it: NEXT_PUBLIC_* values are baked
# in at build time and are not read at runtime.
NEXT_PUBLIC_API_TOKEN=
