# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Everything here is non-secret configuration. No keys or connection strings.
#
# Values marked "terraform output X" come from running `terraform output` in
# infra/terraform.

# --- Storage ---------------------------------------------------------------

# Storage account holding the enterprise knowledge documents.
# terraform output storage_account_name
AZURE_STORAGE_ACCOUNT_NAME=

# Full resource ID of that account. Used as the keyless knowledge source
# connection string in the ResourceId= form, so no account key is needed.
# terraform output storage_account_id
AZURE_STORAGE_ACCOUNT_RESOURCE_ID=

# Container that backs the Foundry IQ knowledge source.
AZURE_KNOWLEDGE_CONTAINER=enterprise-knowledge

# --- Azure AI Search -------------------------------------------------------

# Search endpoint that hosts the knowledge source and knowledge base.
# terraform output search_endpoint
AZURE_SEARCH_ENDPOINT=

# Object names on the search service. Optional; defaults are shown.
# AZURE_KNOWLEDGE_SOURCE_NAME=enterprise-knowledge-source
# AZURE_KNOWLEDGE_BASE_NAME=enterprise-knowledge-base

# Retrieval reasoning effort: minimal, low, medium or auto.
# minimal skips the LLM entirely; low and medium enable query planning.
# AZURE_RETRIEVAL_REASONING_EFFORT=low

# --- Microsoft Foundry project and agent ------------------------------------

# Foundry project endpoint, from the project details in the Foundry portal.
# Shape: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_PROJECT_ENDPOINT=

# Full ARM resource ID of the project. Used to create the MCP project
# connection. Shape:
# /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
AZURE_PROJECT_RESOURCE_ID=

# Name of the RemoteTool project connection that fronts the knowledge base MCP
# endpoint.
AZURE_PROJECT_CONNECTION_NAME=knowledge-base-mcp

# Full resource ID of the Application Insights resource that stores the agent's
# traces, and the target of the AppInsights project connection.
# terraform output application_insights_id
AZURE_APP_INSIGHTS_RESOURCE_ID=

# Connection string of that same Application Insights resource. The project
# connections API requires it to identify the resource when the connection is
# created, even though the runtime authenticates with the project managed
# identity and never uses a key. Read it with:
# terraform output -raw application_insights_connection_string
AZURE_APP_INSIGHTS_CONNECTION_STRING=

# Name of that tracing connection. Optional; default is shown. Azure allows only
# one AppInsights connection per project.
# AZURE_TRACING_CONNECTION_NAME=app-insights

# --- Microsoft Foundry models ----------------------------------------------

# Foundry resource endpoint, WITH NO PATH. This is the value the knowledge
# source uses to reach the models. terraform output ai_foundry_endpoint
#
# Do not use `openai_endpoint` here: that output includes /openai/v1 and is only
# for OpenAI-compatible chat clients. Using it breaks ingestion with 404s.
AZURE_OPENAI_ENDPOINT=

# Chat model. The deployment name comes from Terraform; the model name is the
# underlying model, which must also be offered in the deployed region.
# terraform output llm_deployment_name
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_MODEL=gpt-5.4-mini

# Embedding model required by the Blob knowledge source for vectorization.
# terraform output embedding_deployment_name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
